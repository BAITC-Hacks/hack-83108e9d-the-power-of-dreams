# Copy using: node scripts/secrets/setup.mjs
# Fill only the settings required by the services you use.
# Never commit a filled file or put secrets in browser/public variables.

# Required only for server operations using OpenAI.
OPENAI_API_KEY=
# Optional non-secret override; absent/blank uses gpt-4.1-mini-2025-04-14.
OPENAI_MODEL=

# Required only for server operations using NVIDIA API.
NVIDIA_API_KEY=

# Brev infrastructure access; distinct from NVIDIA hosted-model/NGC keys.
# Required only by scripts/brev/run.mjs; never place the value in CLI arguments.
BREV_API_KEY=

# Required only for server operations using a database.
# Use the connection URI format required by the selected database driver.
# No database engine has been selected yet.
DATABASE_URL=

# Add future server secrets here with empty values and a purpose comment.
# Quote values containing # or whitespace. Variable expansion is not supported.
