# Docker: copy this file to .env using your file manager (preserve an existing file).
# Node.js: node scripts/secrets/setup.mjs
# Fill only the settings required by the services you use.
# Never commit a filled file or put secrets in browser/public variables.

# Required only for server operations using OpenAI.
OPENAI_API_KEY=
# Optional non-secret override; absent/blank uses gpt-5.6-luna.
OPENAI_MODEL=

# Optional Docker Compose host port; blank uses 3101. Not used by npm start.
APP_PORT=

# Quote values containing # or whitespace.
# Direct Node.js loader treats values literally. Compose expands variables;
# use single quotes around literal Compose values containing $ or #.
